<div class="color-{{ section.settings.color_scheme }} password">
  <div class="page-width section text-center">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 400
        | image_tag: class: 'password__logo', widths: '200,400', sizes: '200px', alt: shop.name
      }}
    {%- else -%}
      <h1>{{ shop.name }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <p class="password__error">{{ form.errors.messages.form }}</p>
      {%- endif -%}

      <label class="visually-hidden" for="Password">{{ 'general.password_page.password_label' | t }}</label>
      <input
        id="Password"
        class="field__input"
        type="password"
        name="password"
        autocomplete="current-password"
        required
      >
      <button type="submit" class="button">{{ 'general.password_page.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Opening soon",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Enter the store password to take a look around.</p>",
      "label": "Text"
    }
  ]
}
{% endschema %}
