{%- comment -%}
  Interactive explorer: step through levels or settings with - and + and see
  what each one means. For intensity levels, sizes, strengths, roast levels:
  anything with an ordered range where buyers wonder "which one is me?".

  Every level is rendered as its own panel. Without JavaScript they all show,
  as a list; theme.js turns that into one panel at a time with - / + buttons
  and announces the change to screen readers.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <level-explorer class="level-explorer">
      <div class="level-explorer__intro">
        {%
          render 'section-heading',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          accent: section.settings.accent,
          accent_break: true,
          align: 'left'
        %}
        <div class="rte">{{ section.settings.text }}</div>
      </div>

      <div class="level-explorer__panel">
        {%- if section.settings.image != blank -%}
          <div class="level-explorer__image">
            {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500,750,1000', sizes: '(min-width: 990px) 40vw, 90vw', loading: 'lazy', alt: section.settings.image.alt }}
          </div>
        {%- endif -%}

        <div class="level-explorer__controls">
          <button type="button" class="level-explorer__step" data-level-step="-1" aria-label="{{ 'general.level.previous' | t }}">{% render 'icon', name: 'minus', size: 18 %}</button>
          <p class="level-explorer__current" aria-live="polite" data-level-current></p>
          <button type="button" class="level-explorer__step" data-level-step="1" aria-label="{{ 'general.level.next' | t }}">{% render 'icon', name: 'plus', size: 18 %}</button>
        </div>

        {%- if section.settings.hint != blank -%}
          <p class="level-explorer__hint">{{ section.settings.hint | escape }}</p>
        {%- endif -%}

        {%- assign chips = section.settings.chips | newline_to_br | split: '<br />' -%}
        <ul class="level-explorer__chips" role="list">
          {%- for line in chips -%}
            {%- assign chip = line | strip -%}
            {%- if chip != blank -%}
              <li>{% render 'icon', name: 'check', size: 12 %}{{ chip | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="level-explorer__levels">
          {%- for block in section.blocks -%}
            <div
              class="level-explorer__level{% if forloop.first %} is-active{% endif %}"
              data-level-label="{{ section.settings.level_prefix | escape }} {{ forloop.index }} · {{ block.settings.name | escape }}"
              {{ block.shopify_attributes }}
            >
              <p class="level-explorer__name">{{ section.settings.level_prefix | escape }} {{ forloop.index }} · <em>{{ block.settings.name | escape }}</em></p>
              <dl class="level-explorer__stats">
              {%- for i in (1..3) -%}
                {%- liquid
                  assign label_key = 'stat_' | append: i | append: '_label'
                  assign value_key = 'stat_' | append: i
                -%}
                {%- if section.settings[label_key] != blank -%}
                  <div class="level-explorer__stat">
                    <dt>{{ section.settings[label_key] | escape }}</dt>
                    <dd>{{ block.settings[value_key] | escape }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              </dl>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </level-explorer>
  </div>
</div>

{% schema %}
{
  "name": "Level explorer",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-3", "label": "Color scheme" },
    { "type": "text", "id": "eyebrow", "default": "Adjustable intensity", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "Strong enough to feel.", "label": "Heading" },
    { "type": "text", "id": "accent", "default": "Gentle enough to start.", "label": "Accent line" },
    { "type": "richtext", "id": "text", "default": "<p>Explain what the levels do and how someone should choose a starting point.</p>", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "level_prefix", "default": "Level", "label": "Level word", "info": "As in \"Level 3 · Medium\"." },
    { "type": "text", "id": "hint", "default": "Tap + or − to see what each level is like.", "label": "Hint" },
    { "type": "textarea", "id": "chips", "default": "Start low\nAdjust to comfort\nStops automatically", "label": "Reassurance chips", "info": "One per line." },
    { "type": "header", "content": "What each level shows" },
    { "type": "text", "id": "stat_1_label", "default": "Session time", "label": "First detail" },
    { "type": "text", "id": "stat_2_label", "default": "How it feels", "label": "Second detail" },
    { "type": "text", "id": "stat_3_label", "default": "Best for", "label": "Third detail" }
  ],
  "blocks": [
    {
      "type": "level",
      "name": "Level",
      "settings": [
        { "type": "text", "id": "name", "default": "Gentle", "label": "Name" },
        { "type": "text", "id": "stat_1", "default": "10 min", "label": "First detail" },
        { "type": "text", "id": "stat_2", "default": "Gentle", "label": "Second detail" },
        { "type": "text", "id": "stat_3", "default": "Easing in", "label": "Third detail" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Level explorer",
      "blocks": [
        { "type": "level", "settings": { "name": "Gentle", "stat_1": "10 min", "stat_2": "Gentle", "stat_3": "Easing in" } },
        { "type": "level", "settings": { "name": "Balanced", "stat_1": "6 min", "stat_2": "Noticeable", "stat_3": "Everyday use" } },
        { "type": "level", "settings": { "name": "Strong", "stat_1": "3 min", "stat_2": "Strong", "stat_3": "Fast results" } }
      ]
    }
  ]
}
{% endschema %}
