<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <h1>{{ 'general.search.heading' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.heading' | t }}</label>
      <input
        id="SearchInput"
        class="field__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p>{{ 'general.search.results_count' | t: count: search.results_count }}</p>

        {%- paginate search.results by section.settings.results_per_page -%}
          <ul class="grid" style="--grid-desktop: {{ section.settings.columns }};">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', card_product: item %}
                {%- else -%}
                  <div class="card">
                    <h3 class="card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- else -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Results per page"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
