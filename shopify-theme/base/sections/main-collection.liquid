<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <header class="collection-header">
      <h1>{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="rte">{{ collection.description }}</div>
      {%- endif -%}
      <p class="collection-header__count">
        {{- 'collections.general.products_count' | t: count: collection.products_count -}}
      </p>
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="grid" style="--grid-desktop: {{ section.settings.columns }};">
          {%- for product in collection.products -%}
            <li>
              {% render 'product-card', card_product: product %}
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p>{{ 'collections.general.no_products' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
