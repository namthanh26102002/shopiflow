<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <h1>{{ page_title | escape }}</h1>

    <ul class="grid" style="--grid-desktop: {{ section.settings.columns }};">
      {%- for collection in collections -%}
        <li>
          <div class="card">
            <a class="card__media media media--square" href="{{ collection.url }}" tabindex="-1" aria-hidden="true">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200,300,400,600,800',
                    sizes: '(min-width: 750px) 33vw, 50vw',
                    alt: collection.featured_image.alt
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <h2 class="card__title">
              <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
            </h2>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    }
  ],
  "enabled_on": {
    "templates": ["list-collections"]
  }
}
{% endschema %}
