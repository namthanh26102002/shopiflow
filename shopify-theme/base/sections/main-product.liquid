{%- comment -%}
  Product information: gallery on one side, a stack of reorderable blocks on
  the other.

  The <form> is rendered once, empty apart from the variant id, and every
  control that belongs to it (offer radios, quantity, buy buttons, the sticky
  bar's button) joins it through form="{{ form_id }}". That is what lets the
  merchant put blocks in any order: nothing has to sit inside one <form>
  element for the submit to carry it.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign offers = section.blocks | where: 'type', 'quantity_break'
  assign gifts = section.blocks | where: 'type', 'bundle_gift'
  assign form_id = 'ProductForm-' | append: section.id
  assign offers_rendered = false
  assign gifts_rendered = false

  assign saving_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign saving_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}

<div class="color-{{ section.settings.color_scheme }}">
  {%- comment -%}
    The id is the target the Section Rendering API swaps into on a variant
    change. theme.js looks it up by data-section-id, so renaming either half
    breaks the instant swap (the links still work as plain navigation).
  {%- endcomment -%}
  <div
    id="MainProduct-{{ section.id }}"
    data-section-id="{{ section.id }}"
    class="page-width product-section"
  >
    {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
    {%- endform -%}

    <product-form-controller data-form-id="{{ form_id }}"></product-form-controller>

    {%- if section.settings.show_breadcrumbs -%}
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <ol>
          <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
          {%- comment -%}
            The collection the shopper came through when the URL carries one
            (/collections/x/products/y), otherwise "Shop all".
          {%- endcomment -%}
          {%- if collection -%}
            <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.breadcrumbs.all' | t }}</a></li>
          {%- endif -%}
          <li><span aria-current="page">{{ product.title | escape }}</span></li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="product{% if section.settings.sticky_media %} product--sticky-media{% endif %}">
      <div class="product__media">
        {%
          render 'product-gallery',
          product: product,
          ratio: section.settings.media_ratio,
          thumbs_position: section.settings.thumbs_position
        %}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="product-block">{% render block %}</div>

            {%- when 'rating' -%}
              {%- liquid
                assign rating = product.metafields.reviews.rating.value
                assign rating_count = product.metafields.reviews.rating_count.value | default: 0
              -%}
              {%- if rating != blank -%}
                {%- liquid
                  assign scale = rating.scale_max | default: 5
                  assign on_five = rating.rating | times: 5.0 | divided_by: scale | round: 1
                  assign label = block.settings.label | replace: '[rating]', on_five | replace: '[count]', rating_count
                -%}
                <div class="product-block product-rating" {{ block.shopify_attributes }}>
                  {% render 'rating-stars', rating: on_five, size: 18 %}
                  <span>{{ label | escape }}</span>
                </div>
              {%- elsif request.design_mode -%}
                <p class="product-block editor-note" {{ block.shopify_attributes }}>
                  Star rating appears here once a reviews app writes the product's
                  reviews.rating metafield. Nothing shows to shoppers until then.
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product-block product__title product__title--{{ block.settings.size }}" {{ block.shopify_attributes }}>
                {{- product.title | escape -}}
              </h1>

            {%- when 'pill' -%}
              {%- if block.settings.text != blank -%}
                <div class="product-block" {{ block.shopify_attributes }}>
                  <p class="pill">
                    {%- if block.settings.icon == 'none' -%}
                      <span class="pill__dot" aria-hidden="true"></span>
                    {%- else -%}
                      {% render 'icon', name: block.settings.icon, size: 16 %}
                    {%- endif -%}
                    {{ block.settings.text | escape }}
                  </p>
                </div>
              {%- endif -%}

            {%- when 'headline' -%}
              <h2 class="product-block product-headline product-headline--{{ block.settings.size }}" {{ block.shopify_attributes }}>
                {{- block.settings.text | escape -}}
                {%- if block.settings.accent != blank -%}
                  <br><span class="heading-accent">{{ block.settings.accent | escape }}</span>
                {%- endif -%}
              </h2>

            {%- when 'heading' -%}
              <div class="product-block product-block--heading" {{ block.shopify_attributes }}>
                {%
                  render 'section-heading',
                  eyebrow: block.settings.eyebrow,
                  heading: block.settings.heading,
                  accent: block.settings.accent,
                  align: block.settings.align,
                  level: 'h3'
                %}
              </div>

            {%- when 'text' -%}
              <div class="product-block rte product-text" {{ block.shopify_attributes }}>
                {{- block.settings.text -}}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product-block rte product-text" {{ block.shopify_attributes }}>
                  {{- product.description -}}
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product-block product-price" {{ block.shopify_attributes }}>
                {% render 'price', target: current_variant %}
                {%- if block.settings.show_saving and saving_percent > 0 -%}
                  <span class="save-badge">{{ 'products.product.offers.save' | t: percent: saving_percent }}</span>
                {%- endif -%}
              </div>

            {%- when 'benefit' -%}
              <div class="product-block benefit" {{ block.shopify_attributes }}>
                <span class="icon-tile">{% render 'icon', name: block.settings.icon %}</span>
                <div>
                  <p class="benefit__title">{{ block.settings.title | escape }}</p>
                  {%- if block.settings.text != blank -%}
                    <p class="benefit__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'chips' -%}
              <ul class="product-block chips" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign text_key = 'text_' | append: i
                    assign icon_key = 'icon_' | append: i
                    assign chip_text = block.settings[text_key]
                  -%}
                  {%- if chip_text != blank -%}
                    <li class="chip">
                      {% render 'icon', name: block.settings[icon_key], size: 16 %}
                      {{ chip_text | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'variant_picker' -%}
              <div class="product-block" {{ block.shopify_attributes }}>
                {% render 'variant-picker', product: product, style: block.settings.style, heading: block.settings.heading %}
              </div>

            {%- when 'quantity_break' -%}
              {%- comment -%}
                Every tier renders as one group at the position of the first
                tier block; later tier blocks are already in that group.
              {%- endcomment -%}
              {%- unless offers_rendered -%}
                <div
                  class="product-block offers-wrapper"
                  style="--offer-accent: {{ section.settings.offer_accent }}; --offer-accent-text: {{ section.settings.offer_accent_text }}; --offer-ribbon: {{ section.settings.offer_ribbon }};"
                >
                  {%
                    render 'quantity-offers',
                    offers: offers,
                    variant: current_variant,
                    product: product,
                    heading: section.settings.offers_heading,
                    form_id: form_id,
                    show_thumbnails: section.settings.offer_thumbnails,
                    sale_text: section.settings.offer_sale_text,
                    sale_ends: section.settings.offer_sale_ends,
                    gifts: gifts,
                    gifts_heading: section.settings.gifts_heading
                  %}
                </div>
                {%- assign offers_rendered = true -%}
              {%- endunless -%}

            {%- when 'bundle_gift' -%}
              {%- comment -%}
                With tiers on the page, gifts render inside the tier group,
                under the tiers. Without any, they stand alone here, at the
                position of the first gift block, and are always included.
              {%- endcomment -%}
              {%- if offers.size == 0 -%}
                {%- unless gifts_rendered -%}
                  <div
                    class="product-block offers-wrapper"
                    style="--offer-accent: {{ section.settings.offer_accent }}; --offer-accent-text: {{ section.settings.offer_accent_text }}; --offer-ribbon: {{ section.settings.offer_ribbon }};"
                  >
                    {%
                      render 'bundle-gifts',
                      gifts: gifts,
                      offers: offers,
                      selected_index: 0,
                      form_id: form_id,
                      heading: section.settings.gifts_heading
                    %}
                  </div>
                  {%- assign gifts_rendered = true -%}
                {%- endunless -%}
              {%- endif -%}

            {%- when 'quantity' -%}
              {%- comment -%}
                Offers and this stepper both post "quantity"; offers win.
              {%- endcomment -%}
              {%- if offers.size == 0 -%}
                <div class="product-block" {{ block.shopify_attributes }}>
                  <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                  <quantity-input class="quantity">
                    <button type="button" class="quantity__button" data-action="decrease">
                      <span class="visually-hidden">{{ 'accessibility.decrease_quantity' | t }}</span>
                      &minus;
                    </button>
                    <input
                      id="Quantity-{{ section.id }}"
                      class="quantity__input"
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      inputmode="numeric"
                      form="{{ form_id }}"
                    >
                    <button type="button" class="quantity__button" data-action="increase">
                      <span class="visually-hidden">{{ 'accessibility.increase_quantity' | t }}</span>
                      &plus;
                    </button>
                  </quantity-input>
                </div>
              {%- endif -%}

            {%- when 'bundle' -%}
              {% render 'product-block-bundle', block: block, product: product, current_variant: current_variant, form_id: form_id %}
            {%- when 'buy_buttons' -%}
              {%- comment -%}
                #product-buy is where every mid-page CTA lands (snippets/cta).
                scroll-margin in base.css leaves the offer above it in view.
              {%- endcomment -%}
              <div class="product-block product-buy" id="product-buy" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  form="{{ form_id }}"
                  class="button button--full button--buy"
                  data-main-buy
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span class="button__row">
                  <span class="button__label">
                    {%- if current_variant == nil -%}
                      {{ 'products.product.unavailable' | t }}
                    {%- elsif current_variant.available -%}
                      {%- comment -%}
                        Branch rather than "label | default: key | t": that
                        would push a merchant's own label through the
                        translator and print "translation missing".
                      {%- endcomment -%}
                      {%- if block.settings.label != blank -%}
                        {{ block.settings.label | escape }}
                      {%- else -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- endif -%}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  {%- if block.settings.show_price and current_variant.available -%}
                    <span class="button__price">
                      <span class="button__divider" aria-hidden="true"></span>
                      {{ current_variant.price | money }}
                      {%- if current_variant.compare_at_price > current_variant.price %}
                        <s>{{ current_variant.compare_at_price | money }}</s>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  </span>
                  {%- if block.settings.subtext != blank and current_variant.available -%}
                    <span class="button__sub">{{ block.settings.subtext | escape }}</span>
                  {%- endif -%}
                </button>
              </div>

            {%- when 'payment' -%}
              <div class="product-block payment-trust" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <p class="payment-trust__label">{% render 'icon', name: 'lock', size: 14 %}{{ block.settings.label | escape }}</p>
                {%- endif -%}
                <ul class="payment-trust__icons">
                  {%- for type in shop.enabled_payment_types -%}
                    <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'callout' -%}
              <div class="product-block callout" {{ block.shopify_attributes }}>
                <span class="icon-tile icon-tile--solid">{% render 'icon', name: block.settings.icon %}</span>
                <div>
                  <p class="callout__title">{{ block.settings.title | escape }}</p>
                  {%- if block.settings.text != blank -%}
                    <p class="callout__text">{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'trust_grid' -%}
              {% render 'product-block-trust-grid', block: block %}
            {%- when 'review' -%}
              {% render 'product-block-review', block: block %}
            {%- when 'price_table' -%}
              {% render 'product-block-price-table', block: block, current_variant: current_variant %}
            {%- when 'collapsible' -%}
              <details class="product-block collapsible" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  {%- if block.settings.icon != 'none' -%}
                    <span class="collapsible__icon">{% render 'icon', name: block.settings.icon, size: 18 %}</span>
                  {%- endif -%}
                  <span class="collapsible__title">{{ block.settings.heading | escape }}</span>
                  <span class="collapsible__chevron">{% render 'icon', name: 'chevron-down', size: 18 %}</span>
                </summary>
                <div class="collapsible__content rte">{{ block.settings.content }}</div>
              </details>

            {%- when 'image_carousel' -%}
              {%- liquid
                assign slide_count = 0
                for i in (1..6)
                  assign image_key = 'image_' | append: i
                  if block.settings[image_key] != blank
                    assign slide_count = slide_count | plus: 1
                  endif
                endfor
              -%}
              {%- if slide_count == 0 -%}
                {%- if request.design_mode -%}
                  <p class="product-block editor-note" {{ block.shopify_attributes }}>Add images to show the carousel.</p>
                {%- endif -%}
                {%- continue -%}
              {%- endif -%}
              <div class="product-block" {{ block.shopify_attributes }}>
                <scroll-carousel class="carousel">
                  <ul class="carousel__track" tabindex="0">
                    {%- for i in (1..6) -%}
                      {%- assign image_key = 'image_' | append: i -%}
                      {%- assign slide = block.settings[image_key] -%}
                      {%- if slide != blank -%}
                        <li class="carousel__slide">
                          {{ slide | image_url: width: 900 | image_tag: widths: '450,900', sizes: '(min-width: 990px) 40vw, 90vw', loading: 'lazy', alt: slide.alt }}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  <div class="carousel__controls">
                    <button type="button" class="carousel__nav" data-step="-1" aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18 %}</button>
                    <button type="button" class="carousel__nav" data-step="1" aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18 %}</button>
                  </div>
                </scroll-carousel>
                {%- if block.settings.caption != blank -%}
                  <p class="carousel__caption">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
              </div>

            {%- when 'included' -%}
              {%- comment -%}
                A variant's own list (metafield custom.included, multi-line
                text) wins over the block's, so "Device only" and "Device +
                refills" can each say what is in their box.
              {%- endcomment -%}
              {%- liquid
                assign included_source = current_variant.metafields.custom.included.value | default: block.settings.items
                assign included_lines = included_source | newline_to_br | split: '<br />'
              -%}
              <div class="product-block included" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="included__heading">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                <ul class="included__list" role="list">
                  {%- for line in included_lines -%}
                    {%- assign item = line | strip -%}
                    {%- if item != blank -%}
                      <li><span class="included__tick">{% render 'icon', name: 'check', size: 12 %}</span>{{ item | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'avatars' -%}
              <div class="product-block avatar-stack" {{ block.shopify_attributes }}>
                <span class="avatar-stack__faces">
                  {%- for i in (1..5) -%}
                    {%- assign face_key = 'image_' | append: i -%}
                    {%- assign face = block.settings[face_key] -%}
                    {%- if face != blank -%}
                      {{ face | image_url: width: 96 | image_tag: class: 'avatar-stack__face', widths: '48,96', sizes: '36px', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <p class="avatar-stack__text">{{ block.settings.text }}</p>
              </div>

            {%- when 'installments' -%}
              {%- comment -%}
                Shopify only gives payment_terms a form object inside a
                product form, so this block carries its own small one. It
                renders the Shop Pay Installments message when the store has
                it enabled, and nothing otherwise.
              {%- endcomment -%}
              <div class="product-block installments" {{ block.shopify_attributes }}>
                {%- form 'product', product, class: 'installments__form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
                {%- if block.settings.badge != blank -%}
                  <span class="installments__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
              </div>

            {%- when 'delivery' -%}
              {% render 'product-block-delivery', block: block %}
            {%- when 'testimonial_slider' -%}
              {% render 'product-block-testimonial-slider', block: block %}
            {%- when 'compare' -%}
              {% render 'product-block-compare', block: block %}
            {%- when 'stat_rows' -%}
              {% render 'product-block-stat-rows', block: block %}
            {%- when 'logo_card' -%}
              {%- liquid
                assign logo_count = 0
                for i in (1..4)
                  assign logo_key = 'logo_' | append: i
                  if block.settings[logo_key] != blank
                    assign logo_count = logo_count | plus: 1
                  endif
                endfor
              -%}
              {%- if logo_count == 0 -%}
                {%- if request.design_mode -%}
                  <p class="product-block editor-note" {{ block.shopify_attributes }}>Add logos to show the logo card.</p>
                {%- endif -%}
                {%- continue -%}
              {%- endif -%}
              <div class="product-block logo-card" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="logo-card__heading">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                <ul class="logo-card__logos" role="list">
                  {%- for i in (1..4) -%}
                    {%- assign logo_key = 'logo_' | append: i -%}
                    {%- assign logo = block.settings[logo_key] -%}
                    {%- if logo != blank -%}
                      <li>{{ logo | image_url: width: 240 | image_tag: widths: '120,240', sizes: '120px', loading: 'lazy', alt: logo.alt }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'custom_liquid' -%}
              <div class="product-block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.sticky_bar -%}
      <sticky-buy-bar class="sticky-buy sticky-buy--{{ section.settings.sticky_position }} color-{{ section.settings.color_scheme }}" hidden>
        <div class="sticky-buy__inner page-width">
          <div class="sticky-buy__product">
            {%- assign sticky_media = current_variant.featured_media | default: product.featured_media -%}
            {%- if sticky_media -%}
              {{ sticky_media.preview_image | image_url: width: 120 | image_tag: class: 'sticky-buy__thumb', widths: '60,120', sizes: '48px', loading: 'lazy', alt: '' }}
            {%- endif -%}
            <div>
              <p class="sticky-buy__title">{{ product.title | escape }}</p>
              <p class="sticky-buy__price">
                <strong>{{ current_variant.price | money }}</strong>
                {%- if current_variant.compare_at_price > current_variant.price %}
                  <s>{{ current_variant.compare_at_price | money }}</s>
                  <span class="save-badge save-badge--small">{{ 'products.product.offers.save' | t: percent: saving_percent }}</span>
                {%- endif -%}
              </p>
            </div>
          </div>
          <button
            type="submit"
            name="add"
            form="{{ form_id }}"
            class="button sticky-buy__button"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available and section.settings.sticky_label != blank -%}
              {{ section.settings.sticky_label | escape }}
            {%- elsif current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      </sticky-buy-bar>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "header", "content": "Media" },
    {
      "type": "select",
      "id": "media_ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "square",
      "label": "Image shape"
    },
    {
      "type": "select",
      "id": "thumbs_position",
      "options": [
        { "value": "bottom", "label": "Below the image" },
        { "value": "left", "label": "Left of the image" }
      ],
      "default": "bottom",
      "label": "Thumbnails",
      "info": "Left applies on desktop. Phones always show them below."
    },
    { "type": "checkbox", "id": "sticky_media", "default": true, "label": "Keep gallery in view while scrolling on desktop" },
    { "type": "checkbox", "id": "show_breadcrumbs", "default": false, "label": "Show breadcrumbs" },
    { "type": "header", "content": "Sticky add to cart" },
    { "type": "checkbox", "id": "sticky_bar", "default": true, "label": "Show a buy bar once the main button scrolls away" },
    {
      "type": "select",
      "id": "sticky_position",
      "options": [
        { "value": "bottom", "label": "Bottom of the screen" },
        { "value": "top", "label": "Top of the screen" }
      ],
      "default": "bottom",
      "label": "Bar position"
    },
    { "type": "text", "id": "sticky_label", "label": "Bar button label", "info": "Leave blank for \"Add to cart\"." },
    { "type": "header", "content": "Quantity offers" },
    {
      "type": "paragraph",
      "content": "Quantity offer blocks show bundle tiers. The theme only displays them and adds the chosen quantity to the cart. Create a matching discount in Shopify for each tier, or shoppers will be charged full price."
    },
    { "type": "text", "id": "offers_heading", "label": "Banner above offers" },
    { "type": "checkbox", "id": "offer_thumbnails", "default": true, "label": "Show product image on each offer", "info": "Follows the selected variant. Offers with two or more units show a stacked image. An offer's own image overrides it." },
