{%- comment -%}
  Vertical video testimonials in a swipeable row: a "from … to …" line above
  each video, the person underneath. Videos are uploaded to Shopify (the
  video setting), so they are served from Shopify's CDN with a poster frame.

  Only one plays at a time; theme.js pauses the others. Nothing autoplays:
  testimonials have sound, and sound that starts on its own is a reason to
  leave a page.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    {%
      render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      accent: section.settings.accent,
      subheading: section.settings.subheading
    %}

    <scroll-carousel class="carousel video-reviews">
      <ul class="carousel__track video-reviews__track" tabindex="0" data-one-player>
        {%- for block in section.blocks -%}
          <li class="carousel__slide video-review" {{ block.shopify_attributes }}>
            <p class="video-review__lead">
              {{- block.settings.before | escape }}
              <strong>{{ block.settings.after | escape }}</strong>
            </p>
            <div class="video-review__media media">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '720x' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <p class="video-review__person">
              <strong>{{ block.settings.name | escape }}</strong>
              {%- if block.settings.role != blank -%}<small>{{ block.settings.role | escape }}</small>{%- endif -%}
            </p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="carousel__controls">
        <button type="button" class="carousel__nav" data-step="-1" aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18 %}</button>
        <button type="button" class="carousel__nav" data-step="1" aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18 %}</button>
      </div>
    </scroll-carousel>
  </div>
</div>

{% schema %}
{
  "name": "Video testimonials",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "default": "Real people.", "label": "Heading" },
    { "type": "text", "id": "accent", "default": "Real results.", "label": "Accent text" },
    { "type": "text", "id": "subheading", "default": "In their own words, on their own phones.", "label": "Subheading" },
    { "type": "paragraph", "content": "Upload videos customers have given you permission to use. Vertical (9:16) works best." }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "before", "default": "From never able to switch off to", "label": "Before" },
        { "type": "text", "id": "after", "default": "calm in minutes.", "label": "After", "info": "Shown in bold." },
        { "type": "text", "id": "name", "default": "Customer N.", "label": "Name" },
        { "type": "text", "id": "role", "default": "Job or city", "label": "Detail" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Video testimonials",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
