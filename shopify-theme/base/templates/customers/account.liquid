<div class="page-width section customer-page">
  <h1>{{ 'customer.account.title' | t }}</h1>

  <p>
    <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a>
    &middot;
    <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </p>

  <h2>{{ 'customer.orders.title' | t }}</h2>

  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="cart-items">
        <thead>
          <tr>
            <th scope="col">{{ 'customer.orders.order_number' | t }}</th>
            <th scope="col">{{ 'customer.orders.date' | t }}</th>
            <th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th scope="col">{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: format: 'date' }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p>{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>
