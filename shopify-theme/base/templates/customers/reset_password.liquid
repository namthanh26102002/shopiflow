<div class="page-width section customer-page">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>

  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <label for="ResetPassword">{{ 'customer.login.password' | t }}</label>
    <input id="ResetPassword" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>

    <label for="ResetPasswordConfirm">{{ 'customer.activate_account.confirm_password' | t }}</label>
    <input id="ResetPasswordConfirm" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>

    <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
