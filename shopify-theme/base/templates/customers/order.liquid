<div class="page-width section customer-page">
  <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p>{{ order.created_at | date: format: 'date' }}</p>

  <table class="cart-items">
    <thead>
      <tr>
        <th scope="col">{{ 'cart.item' | t }}</th>
        <th scope="col">{{ 'cart.quantity' | t }}</th>
        <th scope="col">{{ 'cart.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>{{ line_item.title }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div class="cart__footer">
    <div>
      <p>{{ 'cart.subtotal' | t }}: {{ order.subtotal_price | money }}</p>
      <p><strong>{{ 'cart.total' | t }}: {{ order.total_price | money }}</strong></p>
    </div>
  </div>

  <h2>{{ 'customer.order.shipping_address' | t }}</h2>
  <p>{{ order.shipping_address | format_address }}</p>

  <p><a href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
</div>
