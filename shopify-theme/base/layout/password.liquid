{%- comment -%}
  The storefront password page. No navigation, cart or footer: a visitor who
  has not entered the password has nowhere to go but in.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head-common' %}

    {{ content_for_header }}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="template-password">
    <main id="main-content">
      {{ content_for_layout }}
    </main>
  </body>
</html>
