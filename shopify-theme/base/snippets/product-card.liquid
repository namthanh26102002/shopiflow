{%- comment -%}
  Product card.

  Accepts:
  - card_product: a product (required)

  Image shape, vendor and hover behaviour come from theme settings so every
  grid in the theme stays consistent without each section repeating the options.
{%- endcomment -%}

{%- liquid
  assign ratio_class = ''
  case settings.card_image_ratio
    when 'square'
      assign ratio_class = ' media--square'
    when 'portrait'
      assign ratio_class = ' media--portrait'
  endcase

  assign second_image = card_product.media[1].preview_image
-%}

<div class="card">
  <a class="card__media media{{ ratio_class }}" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
    {%- if card_product.featured_media -%}
      {{
        card_product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '200,300,400,600,800',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
          alt: card_product.featured_media.alt
      }}

      {%- if settings.card_show_second_image and second_image -%}
        {{
          second_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'card__media-hover',
            widths: '200,300,400,600,800',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}

    {%- if card_product.available == false -%}
      <span class="badge">{{ 'products.product.sold_out_badge' | t }}</span>
    {%- elsif card_product.compare_at_price > card_product.price -%}
      <span class="badge">{{ 'products.product.sale_badge' | t }}</span>
    {%- endif -%}
  </a>

  {%- if settings.card_show_vendor and card_product.vendor != blank -%}
    <span class="card__vendor">{{ card_product.vendor }}</span>
  {%- endif -%}

  <h3 class="card__title">
    <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
  </h3>

  {% render 'price', target: card_product, show_from: true %}
</div>
