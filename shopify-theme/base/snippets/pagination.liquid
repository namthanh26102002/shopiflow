{%- comment -%}
  Accepts:
  - paginate: the paginate object from inside a {% paginate %} block (required)
{%- endcomment -%}

{%- if paginate.parts.size > 0 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
          {{- part.title -}}
        </a>
      {%- elsif part.title == paginate.current_page -%}
        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
          {{- part.title -}}
        </span>
      {%- else -%}
        {%- comment -%}The gap marker Shopify emits between page ranges.{%- endcomment -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a>
    {%- endif -%}
  </nav>
{%- endif -%}
