{%- comment -%}
  Inline SVG icons, kept in one snippet so stroke weight and sizing stay uniform.

  Accepts:
  - name: the icon name (required). Content icons match the "icon" selects in
    section schemas; scripts/zip.mjs refuses to build if a select offers an
    icon that has no case here.
  - size: pixel size, default 20

  One <svg> wraps every icon, drawn as 1.75px strokes on a 24px grid. The few
  solid shapes (quote, filled star, brand marks) set fill and stroke on their
  own paths, which overrides what they inherit from the wrapper.
{%- endcomment -%}

{%- liquid
  # A missing size is nil in Shopify but 0 in some Liquid engines, and
  # 0 | default leaves 0 alone, so treat both as "not given".
  assign size = size | default: 20
  if size == 0
    assign size = 20
  endif
-%}

<svg
  class="icon icon--{{ name }}"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.78L20 8H6"/><circle cx="9.5" cy="20" r="1.25"/><circle cx="17" cy="20" r="1.25"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close', 'x' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'chevron-right' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'chevron-down' -%}
      <path d="M5 9l7 7 7-7"/>
    {%- when 'quote' -%}
      <path fill="currentColor" stroke="none" d="M4 18v-5.5C4 8.4 6.2 6 9.5 5.5l.5 1.6C8 7.8 7.2 9.2 7.1 11H10v7H4zm10 0v-5.5c0-4.1 2.2-6.5 5.5-7l.5 1.6c-2 .7-2.8 2.1-2.9 3.9H20v7h-6z"/>
    {%- when 'star-fill' -%}
      <path fill="currentColor" stroke="none" d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"/>
    {%- when 'shield' -%}
      <path d="M12 3l7 3v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6l7-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/>
    {%- when 'package' -%}
      <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>
    {%- when 'refresh' -%}
      <path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'cup' -%}
      <path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 10h2a2.5 2.5 0 0 1 0 5h-2M8 3v3M12 3v3"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
    {%- when 'zap' -%}
      <path d="M13 3L5 14h6l-1 7 8-11h-6z"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13"/><path d="M12 8c-1.5-3-5-4-5-1.5S10 8 12 8zm0 0c1.5-3 5-4 5-1.5S14 8 12 8z"/>
    {%- when 'chat' -%}
      <path d="M4 5h16v11H9l-5 4z"/>
    {%- when 'home' -%}
      <path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'power' -%}
      <path d="M12 3v8"/><path d="M7 6.5a7 7 0 1 0 10 0"/>
    {%- when 'activity' -%}
      <path d="M3 12h4l3 7 4-14 3 7h4"/>
    {%- when 'target' -%}
      <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 21l5-3 5 3-1.5-7"/>
    {%- when 'eye-off' -%}
      <path d="M3 3l18 18"/><path d="M10.6 6.1A9.8 9.8 0 0 1 12 6c5 0 9 6 9 6a15 15 0 0 1-3 3.5M6.6 7.6C4.4 9.1 3 12 3 12s4 6 9 6a8.6 8.6 0 0 0 4.1-1"/><path d="M10 10a3 3 0 0 0 4 4"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    {%- when 'smile' -%}
      <circle cx="12" cy="12" r="9"/><path d="M8.5 14.5s1.3 2 3.5 2 3.5-2 3.5-2M9 9.5h.01M15 9.5h.01"/>
    {%- when 'ban' -%}
      <circle cx="12" cy="12" r="9"/><path d="M5.7 5.7l12.6 12.6"/>
    {%- when 'chart' -%}
      <path d="M4 20V10M10 20V4M16 20v-7M3 20h18"/>
    {%- when 'card' -%}
      <rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    {%- when 'tiktok' -%}
      <path fill="currentColor" stroke="none" d="M16.5 3h-2.6v11.3a2.4 2.4 0 1 1-1.9-2.35V9.3a5 5 0 1 0 4.5 4.98V8.4a5.3 5.3 0 0 0 3.2 1.08V6.9a3.2 3.2 0 0 1-3.2-3.2Z"/>
    {%- when 'facebook' -%}
      <path fill="currentColor" stroke="none" d="M14 9h2.5V6H14c-2 0-3.5 1.5-3.5 3.5V11H8.5v3h2V21h3v-7h2.3l.45-3H13.5V9.8c0-.5.3-.8.5-.8Z"/>
    {%- when 'youtube' -%}
      <path fill="currentColor" stroke="none" d="M21.3 7.9a2.4 2.4 0 0 0-1.7-1.7C18 5.8 12 5.8 12 5.8s-6 0-7.6.4A2.4 2.4 0 0 0 2.7 7.9C2.3 9.5 2.3 12 2.3 12s0 2.5.4 4.1a2.4 2.4 0 0 0 1.7 1.7c1.6.4 7.6.4 7.6.4s6 0 7.6-.4a2.4 2.4 0 0 0 1.7-1.7c.4-1.6.4-4.1.4-4.1s0-2.5-.4-4.1ZM10.2 15.1V8.9l5.2 3.1-5.2 3.1Z"/>
  {%- endcase -%}
</svg>
