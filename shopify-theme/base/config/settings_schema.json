[
  {
    "name": "theme_info",
    "theme_name": "Shopiflow",
    "theme_version": "0.1.0",
    "theme_author": "Shopiflow",
    "theme_documentation_url": "https://www.tryshopiflow.com/themes",
    "theme_support_url": "https://www.tryshopiflow.com/themes"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 280,
        "step": 10,
        "default": 120,
        "unit": "px",
        "label": "Logo width"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Shown in the browser tab. 48 x 48px or larger, square."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the background color where it is set."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#151515"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button background",
            "default": "#151515"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button text",
            "default": "#151515"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders and dividers",
            "default": "#DCDCDC"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#009975",
            "info": "Highlights, badges, ticks and the colored part of two-tone headings."
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "assistant_n4",
        "label": "Heading font"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "Heading size"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body font"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "Body size"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1280,
        "unit": "px",
        "label": "Page width"
      },
      {
        "type": "range",
        "id": "page_gutter",
        "min": 12,
        "max": 48,
        "step": 2,
        "default": 20,
        "unit": "px",
        "label": "Edge padding",
        "info": "Space between content and the edge of the screen on mobile."
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "default": 64,
        "unit": "px",
        "label": "Space between sections"
      }
    ]
  },
  {
    "name": "Shapes",
    "settings": [
      {
        "type": "header",
        "content": "Buttons"
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 6,
        "unit": "px",
        "label": "Corner radius"
      },
      {
        "type": "range",
        "id": "button_border_width",
        "min": 0,
        "max": 4,
        "step": 1,
        "default": 1,
        "unit": "px",
        "label": "Border thickness"
      },
      {
        "type": "header",
        "content": "Cards and inputs"
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 8,
        "unit": "px",
        "label": "Card corner radius"
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 6,
        "unit": "px",
        "label": "Input corner radius"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "default": false,
        "label": "Show vendor"
      },
      {
        "type": "checkbox",
        "id": "card_show_second_image",
        "default": true,
        "label": "Show second image on hover"
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ],
        "default": "square",
        "label": "Image shape"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          {
            "value": "page",
            "label": "Cart page"
          },
          {
            "value": "drawer",
            "label": "Slide-out drawer"
          }
        ],
        "default": "drawer",
        "label": "Cart style"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "default": false,
        "label": "Enable order notes"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/shop"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      }
    ]
  }
]
